{
  "name": "nestify",
  "version": "1.0.0",
  "description": "Nestify - Apple Liquid Glass Spotify touch controller for Google Nest Hub to control Spotify Desktop on Windows PC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "autocast": "node server.js --autocast",
    "stop": "powershell -Command \"Get-NetTCPConnection -LocalPort 8888 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
  },
  "keywords": [
    "spotify",
    "apple-carplay",
    "nest-hub",
    "google-cast",
    "dashcast",
    "touchscreen",
    "smart-display"
  ],
  "author": "Emulith <verrietnick2009@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/emulith/Nestify.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
